# ==============================================================================
# Career Pulse & Radar — Unified Monorepo Environment Configuration
# Copy this file to .env locally or paste these keys into Vercel/Render Environment Variables.
# ==============================================================================

# Authentication Credentials (Required for dashboard access)
# Set AUTH_PASSWORD once to bootstrap the initial admin account; it is
# stored as a PBKDF2 hash in the database. There is no default password.
EMAIL=your-email@gmail.com
AUTH_PASSWORD=choose-a-strong-password

# Database: In production, supply your Supabase PostgreSQL connection string
# (Supabase Dashboard -> Project Settings -> Database -> Connection string URI).
# Leave blank for local development (uses throwaway in-memory SQLite).
DATABASE_URL=

# Supabase Storage & Cloud Sync (Required for storing generated FlowCV PDF resumes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_RESUME_BUCKET=resumes

# LLM: Groq AI for Job Intake, Extraction, ATS Optimization & Email Generation
# Three keys are rotated for rate-limit resilience (Request 1 -> Key 1, ...).
# LLM_API_KEY is kept as a legacy fallback.
GROQ_API_KEY_1=your-groq-key-1
GROQ_API_KEY_2=your-groq-key-2
GROQ_API_KEY_3=your-groq-key-3
LLM_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Session signing secret (REQUIRED in production/Vercel — generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))")
SESSION_SECRET=generate-a-random-value

# Outbound Email Dispatch: SMTP credentials (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# Email Dispatch Safety (safe defaults: test mode ON, live send OFF):
# CAREERPULSE_TEST_MODE=1 redirects every email to JOBHUNTER_TEST_RECIPIENT.
# CAREERPULSE_ALLOW_REAL_EMAIL=1 is required to send to real employers.
CAREERPULSE_TEST_MODE=1
CAREERPULSE_ALLOW_REAL_EMAIL=0
JOBHUNTER_TEST_RECIPIENT=your-test-email@gmail.com

# Radar Job Discovery APIs:
BRAVE_API_KEY=
SERPAPI_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API=

# Radar Settings
EXPIRY_HOURS_DEFAULT=48
EXPIRY_HOURS_POST_DEADLINE=24
MAX_JOB_AGE_DAYS=3
